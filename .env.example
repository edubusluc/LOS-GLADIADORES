# Copia este fichero como .env (junto a manage.py) y rellena los valores.
# El .env nunca se sube a git.

# --- En tu ordenador ---------------------------------------------------------
# Modo desarrollo: muestra los errores con detalle y sirve los ficheros estáticos.
# Con DJANGO_DEBUG=True las claves de abajo son opcionales.
DJANGO_DEBUG=True

# --- En producción (DJANGO_DEBUG=False o sin definir) ------------------------
# Obligatoria, mínimo 50 caracteres. Genérala con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Obligatoria. Cifra las cuentas SNP de los clubes; si la cambias, hay que volver a
# introducirlas. Genérala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Dominios de la web, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes https de confianza para los formularios (p. ej. https://tu-dominio).
DJANGO_CSRF_TRUSTED_ORIGINS=
# Pon True si el hosting tiene delante un proxy que termina el https.
DJANGO_BEHIND_PROXY=False
# Redirección a https (True en producción salvo que lo haga el proxy).
DJANGO_SECURE_SSL_REDIRECT=True
# HSTS en segundos: empieza con 3600 y súbelo a 31536000 cuando todo vaya por https.
DJANGO_SECURE_HSTS_SECONDS=3600

# --- Base de datos ------------------------------------------------------------
# Sin DATABASE_URL se usa SQLite (db.sqlite3). En producción, PostgreSQL:
# DATABASE_URL=postgres://usuario:contraseña@servidor:5432/zyra
DATABASE_URL=
# Segundos que se reutiliza cada conexión (0 = abrir una por petición).
DATABASE_CONN_MAX_AGE=60

# --- Logs y errores -----------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
# Opcional: DSN de Sentry para recibir los errores agrupados.
SENTRY_DSN=

# --- Correo (informes de convocatoria) ---------------------------------------
EMAIL_HOST_PASSWORD=

# --- Inicio de sesión con Google (opcional) -----------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
